<Window x:Class="DormitoryApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="400" Width="350"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <Label Content="Введіть ПІБ:"/>
        <TextBox x:Name="FullNameTextBox"/>

        <Label Content="Придумайте логін:"/>
        <TextBox x:Name="LoginTextBox"/>

        <Label Content="Придумайте пароль:"/>
        <PasswordBox x:Name="UserPasswordBox" Margin="5"/>

        <Button Content="Зареєструватися" Click="RegisterButton_Click"/>
        <Button Content="Назад" Click="BackButton_Click"/>

        <TextBlock x:Name="StatusTextBlock" Foreground="Red" Margin="0,10" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>