<Window x:Class="DormitoryApp.Views.ResidentsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список мешканців" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <StackPanel>
            <Label Content="Загальний список мешканців:" FontSize="16" FontWeight="Bold"/>

            <TextBox x:Name="SearchTextBox" Margin="0,5,0,10" 
                     ToolTip="Пошук за прізвищем..." 
                     TextChanged="SearchTextBox_TextChanged"/>

            <DataGrid x:Name="ResidentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ПІБ Студента" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="150"/>
                    <DataGridTextColumn Header="Кімната" Binding="{Binding AssignedRoom}" Width="100"/>
                    <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="150"/>
                    <DataGridTextColumn Header="Студентський" Binding="{Binding StudentId}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>