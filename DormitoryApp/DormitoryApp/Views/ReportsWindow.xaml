<Window x:Class="DormitoryApp.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формування звітів" Height="450" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Label Content="Оберіть тип звіту:" FontSize="16" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Звіт по оплаті" Click="PaymentReport_Click" IsEnabled="False"/>
                <Button Content="Звіт по поселенню" Click="SettlementReport_Click"/>
                <Button Content="Звіт по вільних місцях" Click="AvailabilityReport_Click" IsEnabled="True"/>
            </StackPanel>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="ReportTextBox" 
                 Text="Результати звіту з'являться тут..."
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" 
                 IsReadOnly="True" 
                 Background="#FF3A4C70" 
                 Foreground="White"
                 FontFamily="Consolas"
                 FontSize="14"/>
    </Grid>
</Window>