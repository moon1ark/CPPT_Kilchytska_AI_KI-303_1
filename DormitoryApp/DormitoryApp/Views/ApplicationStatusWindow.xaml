<Window x:Class="DormitoryApp.Views.ApplicationStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статус заявки" Height="200" Width="300"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Label Content="Поточний статус:" FontSize="16"/>

        <TextBlock x:Name="StatusTextBlock" Text="Завантаження..." FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="5"/>

        <Button Content="Оновити" Margin="0,20" Click="UpdateButton_Click"/>
    </StackPanel>
</Window>